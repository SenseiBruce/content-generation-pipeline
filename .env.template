# ─────────────────────────────────────────────────────────────────────────────
# Capital Architects — Environment Configuration Template
# Copy this file to .env and fill in your actual keys.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── OpenRouter (Script Generation + Judging) ──────────────────────────────────
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# GPT-4o is used for script generation and judging (quality-critical)
OPENROUTER_MODEL=openai/gpt-4o

# ── Runware (AI Image Generation) ────────────────────────────────────────────
# Get your key at: https://runware.ai
RUNWARE_API_KEY=your_runware_api_key_here

# ─────────────────────────────────────────────────────────────────────────────
# YouTube OAuth credentials are managed via youtube_token.json
# Run auth_youtube.py once to generate the token from client_secret.json
# ─────────────────────────────────────────────────────────────────────────────
